---
/**
 * Botón flotante de WhatsApp.
 *
 * Aparece recién después del hero: ahí arriba ya hay un botón visible y taparlo
 * con otro solo estorba. Se muestra cuando el visitante scrolleó lo suficiente
 * como para estar realmente considerando la consulta.
 */
import { linkWhatsApp } from '@/data/sitio';

const wa = linkWhatsApp('Hola Ignacio, quiero consultarte por una mezcla.');
---

<a
  href={wa}
  target="_blank"
  rel="noopener noreferrer"
  data-wa-flotante
  class="bg-marca hover:bg-marca-clara fixed right-5 bottom-5 z-40 grid size-14 translate-y-4 place-items-center rounded-full text-black opacity-0 shadow-lg shadow-black/40 transition-all duration-300 data-[visible]:translate-y-0 data-[visible]:opacity-100 lg:hidden"
  aria-label="Escribir por WhatsApp"
>
  <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.17-.28.19-.52.07-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.2-1.44-1.35-1.68-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.53-1.32-.75-1.8-.19-.44-.38-.4-.53-.4z"
    ></path>
  </svg>
</a>

<script>
  const boton = document.querySelector<HTMLElement>('[data-wa-flotante]');
  const hero = document.querySelector('#inicio');

  if (boton && hero) {
    const observador = new IntersectionObserver(
      ([entrada]) => {
        if (entrada.isIntersecting) boton.removeAttribute('data-visible');
        else boton.setAttribute('data-visible', '');
      },
      { threshold: 0 }
    );
    observador.observe(hero);
  }
</script>
