---
/**
 * Preguntas frecuentes.
 *
 * Usa <details> nativo: se abre y cierra sin una línea de JavaScript, funciona
 * con teclado y lector de pantalla desde el navegador, y el contenido está en el
 * HTML aunque esté plegado, que es lo que necesita Google para indexarlo.
 */
import TituloSeccion from '@/components/ui/TituloSeccion.astro';
import { faq } from '@/data/faq';
---

<section id="preguntas" class="contenedor scroll-mt-24 py-20 lg:py-28" data-revelar>
  <TituloSeccion rotulo="Preguntas" titulo="Lo que suelen preguntarme" />

  <div class="divide-borde border-borde mt-10 max-w-3xl divide-y border-y lg:mt-12">
    {
      faq.map((item) => (
        <details class="group">
          <summary class="text-texto hover:text-marca-clara flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-sans text-base font-medium transition-colors">
            {item.pregunta}
            <svg
              viewBox="0 0 20 20"
              class="text-marca mt-1 size-4 shrink-0 transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <path fill="currentColor" d="M9 3h2v14H9z" />
              <path fill="currentColor" d="M3 9h14v2H3z" />
            </svg>
          </summary>
          <p class="text-texto-suave pr-10 pb-5 text-sm leading-relaxed">{item.respuesta}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Safari sigue dibujando su triángulo si no se lo saca explícitamente. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
