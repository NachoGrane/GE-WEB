---
/**
 * Servicios. Las tarjetas salen de src/data/servicios.ts: sumar mastering es
 * agregar un objeto ahí, sin tocar este archivo.
 */
import TituloSeccion from '@/components/ui/TituloSeccion.astro';
import Boton from '@/components/ui/Boton.astro';
import { servicios, precioDesde } from '@/data/servicios';
import { linkWhatsApp } from '@/data/sitio';
---

<section id="servicios" class="contenedor scroll-mt-24 py-20 lg:py-28" data-revelar>
  <TituloSeccion
    rotulo="Servicios"
    titulo="Cómo puedo ayudarte"
    bajada="El precio final depende de la cantidad de pistas y de la complejidad del tema. Escribime y te paso una cotización concreta el mismo día."
  />

  <div class="mt-10 grid gap-6 lg:mt-12 lg:grid-cols-2">
    {
      servicios.map((servicio) => (
        <article
          class:list={[
            'flex flex-col rounded-2xl border p-7 sm:p-8',
            servicio.destacado ? 'border-marca/40 bg-marca-tenue' : 'border-borde bg-fondo-elevado',
          ]}
        >
          {servicio.destacado && (
            <p class="bg-marca mb-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold tracking-wider text-black uppercase">
              Más pedido
            </p>
          )}

          <h3 class="fuente-display text-texto text-3xl">{servicio.nombre}</h3>
          <p class="text-texto-suave mt-2">{servicio.resumen}</p>

          <p class="text-marca-clara mt-6 font-sans text-2xl font-semibold tracking-tight">
            {precioDesde(servicio)}
          </p>

          <ul class="border-borde text-texto-suave mt-6 space-y-3 border-t pt-6 text-sm">
            {servicio.incluye.map((item) => (
              <li class="flex gap-3">
                <svg
                  viewBox="0 0 20 20"
                  class="text-marca mt-0.5 size-4 shrink-0"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="M8.2 13.6 4.9 10.3l1.2-1.2 2.1 2.1 5.7-5.7 1.2 1.2z"
                  />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-8 pt-2">
            <Boton
              href={linkWhatsApp(
                `Hola Ignacio, me interesa el servicio de ${servicio.nombre}. ¿Me pasás una cotización?`
              )}
              variante={servicio.destacado ? 'principal' : 'secundario'}
              nuevaPestania
              class="w-full"
            >
              Consultar por {servicio.nombre}
            </Boton>
          </div>
        </article>
      ))
    }
  </div>
</section>
