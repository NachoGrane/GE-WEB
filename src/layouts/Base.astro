---
/**
 * Estructura del documento: <head> completo, metadatos, datos estructurados y
 * el observador que revela las secciones al hacer scroll.
 */
import '@/styles/global.css';
import { sitio } from '@/data/sitio';
import { grafoJsonLd } from '@/lib/schema';

const canonica = new URL('/', Astro.site ?? sitio.dominio).href;
const imagenOg = new URL('/og.png', Astro.site ?? sitio.dominio).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{sitio.titulo}</title>
    <meta name="description" content={sitio.descripcion} />
    <link rel="canonical" href={canonica} />

    <!-- Las fuentes son lo primero que necesita el titular: sin preload el
         navegador recién las descubre al parsear el CSS. -->
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={sitio.titulo} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(grafoJsonLd())} is:inline />
  </head>

  <body>
    <a
      href="#contenido"
      class="bg-marca sr-only rounded-sm px-4 py-2 font-medium text-black focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      Saltar al contenido
    </a>

    <slot />
  </body>
</html>
